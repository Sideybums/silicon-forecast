{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silicon-forecast",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "siliconforecast.com",
      "custom_domain": true
    }
  ]
}
