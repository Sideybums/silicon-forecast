{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siliconforecast.com/schemas/daily-market-dashboard.v1.schema.json",
  "title": "Silicon Forecast daily observed-market dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "dataset_id", "market", "currency", "time_zone", "first_date", "latest_date", "declared_products", "points", "excluded"],
  "properties": {
    "policy_id": { "const": "sf-daily-market-dashboard-v1" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "market": { "const": "GB" },
    "currency": { "const": "GBP" },
    "time_zone": { "const": "Europe/London" },
    "first_date": { "type": "string", "format": "date" },
    "latest_date": { "type": "string", "format": "date" },
    "declared_products": { "type": "array", "minItems": 1 },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "typical_minor", "low_minor", "high_minor", "product_count", "declared_product_count", "retailer_count", "observation_count", "coverage_permille", "capture_basis", "products", "low_evidence", "high_evidence"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "typical_minor": { "type": "integer", "minimum": 1 },
          "low_minor": { "type": "integer", "minimum": 1 },
          "high_minor": { "type": "integer", "minimum": 1 },
          "product_count": { "type": "integer", "minimum": 1 },
          "declared_product_count": { "type": "integer", "minimum": 1 },
          "retailer_count": { "type": "integer", "minimum": 1 },
          "observation_count": { "type": "integer", "minimum": 1 },
          "coverage_permille": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "capture_basis": { "enum": ["archive", "direct", "mixed"] },
          "products": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mpn", "median_minor", "low_minor", "high_minor", "retailer_count"],
              "properties": {
                "mpn": { "type": "string", "minLength": 1 },
                "median_minor": { "type": "integer", "minimum": 1 },
                "low_minor": { "type": "integer", "minimum": 1 },
                "high_minor": { "type": "integer", "minimum": 1 },
                "retailer_count": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "low_evidence": { "$ref": "#/$defs/evidence" },
          "high_evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_in_stock_count", "sentinel_price_count"],
      "properties": {
        "not_in_stock_count": { "type": "integer", "minimum": 0 },
        "sentinel_price_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["public_observation_id", "observed_at", "observation_kind", "mpn", "retailer_id", "retailer_name", "item_price_minor", "source_url"],
        "properties": {
          "public_observation_id": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "format": "date-time" },
          "observation_kind": { "enum": ["direct_retail_observation", "archived_retail_observation"] },
          "mpn": { "type": "string", "minLength": 1 },
          "retailer_id": { "type": "string", "minLength": 1 },
          "retailer_name": { "type": "string", "minLength": 1 },
          "item_price_minor": { "type": "integer", "minimum": 1 },
          "source_url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
