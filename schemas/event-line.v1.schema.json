{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siliconforecast.com/schemas/event-line.v1.schema.json",
  "title": "Silicon Forecast reviewed public event line",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "dataset_id", "category_slug", "status", "markers"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_id": { "const": "sf-public-event-line-v1" },
    "dataset_id": { "const": "sf-public-event-line-ram-v1" },
    "category_slug": { "const": "ram" },
    "status": { "enum": ["empty_pending_review", "reviewed_markers_published"] },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "headline", "publisher", "author", "source_url", "publication_date", "event_date", "interpretation", "uncertainty", "counter_evidence", "revision"],
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "headline": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "author": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "publication_date": { "type": "string", "format": "date" },
          "event_date": { "type": "string", "format": "date" },
          "interpretation": { "type": "string", "minLength": 1 },
          "uncertainty": { "type": "string", "minLength": 1 },
          "counter_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "revision": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "empty_pending_review" } } }, "then": { "properties": { "markers": { "maxItems": 0 } } } },
    { "if": { "properties": { "status": { "const": "reviewed_markers_published" } } }, "then": { "properties": { "markers": { "minItems": 1 } } } }
  ]
}
