<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily canonical collector job.

  RunAtLoad is false on purpose: installing the job should not immediately fetch
  from five retailers as a side effect of a `launchctl load`.

  launchd does not queue missed occurrences. A machine asleep at 11:30 runs the
  job once when it next wakes, and days skipped entirely are simply never fired.
  The collector therefore records missed scheduled slots itself, in
  data/collection-runs/ledger.v1.json, so an outage is reviewable afterwards
  rather than silently absent.

  Install and remove with ops/install-collector.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>uk.co.siliconforecast.collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>__REPO__/scripts/run-canonical-collector.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SF_COLLECTOR_CHECKOUT</key>
    <string>__REPO__</string>
    <key>SF_COLLECTOR_BRANCH</key>
    <string>main</string>
    <key>SF_COLLECTOR_LOCK</key>
    <string>__LOCK__</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>11</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__REPO__/logs/collector.out.log</string>

  <key>StandardErrorPath</key>
  <string>__REPO__/logs/collector.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
